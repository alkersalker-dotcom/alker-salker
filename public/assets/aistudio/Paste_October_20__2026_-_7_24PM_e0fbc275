                    loginPassword.value = '';
                }

                loginTeknisi.innerHTML = `<option value="">-- Pilih Nama Teknisi / User --</option>`;

                if (selectedUnit) {
                    const filteredTeknisi = masterTeknisi.filter(t => t.unit === selectedUnit);
                    filteredTeknisi.forEach(t => {
                        const opt = document.createElement('option');
                        opt.value = t.name;
                        opt.textContent = t.name;
                        loginTeknisi.appendChild(opt);
                    });
                    loginTeknisi.disabled = false;
                    loginTeknisi.classList.remove('bg-slate-100');

                    if (selectedUnit === 'ADMIN') {
                        loginTeknisi.value = 'ADMIN';
                    } else if (currentSelectedTeknisi) {
                        const isValidCombo = masterTeknisi.some(t => t.name === currentSelectedTeknisi && t.unit === selectedUnit);
                        if (!isValidCombo) {
                            showLoginError("Maaf cek kembali Unit Anda");
                        } else {
                            loginTeknisi.value = currentSelectedTeknisi;
                        }
                    }
                } else {
                    loginTeknisi.disabled = true;
                    loginTeknisi.classList.add('bg-slate-100');
                }
            });

            mainLoginForm.addEventListener('submit', (e) => {
                e.preventDefault();
                hideLoginError();

                const unitVal = loginUnit.value;
                const nameVal = loginTeknisi.value;
                const passVal = loginPassword.value;

                if (!unitVal || !nameVal) return;

                if (unitVal === 'ADMIN' && nameVal === 'ADMIN') {
                    if (passVal !== 'ADMIN 123') {
                        showLoginError("Password Admin Salah! Gunakan 'ADMIN 123'");
                        return;
                    }
                }

                const matchedUser = masterTeknisi.find(t => t.name === nameVal && t.unit === unitVal);

                if (!matchedUser) {
                    showLoginError("Maaf cek kembali Unit Anda");
                    return;
                }

                currentUser = { name: matchedUser.name, unit: matchedUser.unit, isAdmin: (matchedUser.unit === 'ADMIN') };
                localStorage.setItem('cek_alker_user', JSON.stringify(currentUser));

                updateAuthUI();
                renderTable();
                updateStats();
            });

            btnLogout.addEventListener('click', () => {
                currentUser = null;
                localStorage.removeItem('cek_alker_user');
                updateAuthUI();
            });

            btnOpenModal.addEventListener('click', () => {
                alkerForm.reset();
                document.getElementById('editId').value = "";
                document.getElementById('fieldTeknisi').value = currentUser.name;
                document.getElementById('fieldUnit').value = currentUser.unit;
                document.getElementById('fieldKeterangan').value = '';
                currentPhotoBase64 = '';
                imagePreviewContainer.classList.add('hidden');
                document.getElementById('modalTitle').textContent = "Form Input Cek Alat Kerja";
                modalForm.classList.remove('hidden');
            });

            btnCloseModal.addEventListener('click', () => modalForm.classList.add('hidden'));
            btnCancel.addEventListener('click', () => modalForm.classList.add('hidden'));
            btnCloseImageModal.addEventListener('click', () => imageModal.classList.add('hidden'));

            alkerForm.addEventListener('submit', async (e) => {
                e.preventDefault();

                const editId = document.getElementById('editId').value;
                const now = new Date();
                const timeStampStr = now.toLocaleDateString('id-ID') + ' ' + now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' });
                const docId = editId ? editId : 'alker_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);

                const newItem = {
                    id: docId,
                    alatKerja: document.getElementById('fieldAlatKerja').value,
                    merkType: document.getElementById('fieldMerkType').value,
                    posisiAlker: document.getElementById('fieldPosisiAlker').value,
                    teknisi: document.getElementById('fieldTeknisi').value,
                    unit: document.getElementById('fieldUnit').value,
                    sto: document.getElementById('fieldSTO').value.toUpperCase(),
                    status: document.getElementById('fieldStatus').value,
                    keterangan: document.getElementById('fieldKeterangan').value,
                    foto: currentPhotoBase64,
                    updatedAt: timeStampStr,
                    createdAtTime: Date.now()
                };

                const btnSaveAlker = document.getElementById('btnSaveAlker');
                btnSaveAlker.disabled = true;
                btnSaveAlker.textContent = "Menyimpan ke Cloud...";

                try {
                    if (typeof window.db !== 'undefined' && window.cloudFunctions) {
                        const { doc, setDoc } = window.cloudFunctions;
                        await setDoc(doc(window.db, 'artifacts', window.appId, 'public', 'data', 'public_data', docId), newItem);
                    }

                    const index = dataAlker.findIndex(d => d.id === docId);
                    if (index >= 0) {
                        dataAlker[index] = newItem;
                    } else {
                        dataAlker.unshift(newItem);
                    }
                    localStorage.setItem('cek_alker_db', JSON.stringify(dataAlker));

                    modalForm.classList.add('hidden');
                    renderTable();
                    updateStats();
                } catch (err) {
                    console.error("Error saving to Firestore:", err);
                    alert("Gagal menyimpan ke Cloud. Periksa koneksi internet Anda.");
                } finally {
                    btnSaveAlker.disabled = false;
                    btnSaveAlker.innerHTML = `<i data-lucide="save" class="w-4 h-4"></i><span>Simpan Data</span>`;
                    lucide.createIcons();
                }
            });

            fieldFoto.addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(event) {
                        currentPhotoBase64 = event.target.result;
                        imagePreview.src = currentPhotoBase64;
                        imagePreviewContainer.classList.remove('hidden');
                    };
                    reader.readAsDataURL(file);
                }
            });

            btnRemoveImage.addEventListener('click', () => {
                currentPhotoBase64 = '';
                fieldFoto.value = '';
                imagePreviewContainer.classList.add('hidden');
            });

            btnOpenCamera.addEventListener('click', async () => {
                cameraModal.classList.remove('hidden');
                try {
                    mediaStream = await navigator.mediaDevices.getUserMedia({
                        video: { facingMode: useFacingMode },
                        audio: false
                    });
                    cameraStream.srcObject = mediaStream;
                } catch (err) {
                    alert("Tidak dapat mengakses kamera perangkat. Pastikan izin kamera diaktifkan.");
                    cameraModal.classList.add('hidden');
                }
            });

            btnCloseCamera.addEventListener('click', () => {
                if (mediaStream) {
                    mediaStream.getTracks().forEach(track => track.stop());
                }
                cameraModal.classList.add('hidden');
            });

            btnSwitchCamera.addEventListener('click', async () => {
                if (mediaStream) {
                    mediaStream.getTracks().forEach(track => track.stop());
                }
                useFacingMode = useFacingMode === "environment" ? "user" : "environment";
                try {
                    mediaStream = await navigator.mediaDevices.getUserMedia({
                        video: { facingMode: useFacingMode },
                        audio: false
                    });
                    cameraStream.srcObject = mediaStream;
                } catch (err) {
                    console.error(err);
                }
            });

            btnCapturePhoto.addEventListener('click', () => {
                const width = cameraStream.videoWidth || 640;
                const height = cameraStream.videoHeight || 480;
                cameraCanvas.width = width;
                cameraCanvas.height = height;
                const ctx = cameraCanvas.getContext('2d');
                ctx.drawImage(cameraStream, 0, 0, width, height);

                currentPhotoBase64 = cameraCanvas.toDataURL('image/jpeg', 0.85);
                imagePreview.src = currentPhotoBase64;
                imagePreviewContainer.classList.remove('hidden');

                if (mediaStream) {
                    mediaStream.getTracks().forEach(track => track.stop());
                }
                cameraModal.classList.add('hidden');
            });

            searchInput.addEventListener('input', renderTable);
            filterPosisi.addEventListener('change', renderTable);
            filterStatus.addEventListener('change', renderTable);

            btnInstallPWA.addEventListener('click', () => pwaGuideModal.classList.remove('hidden'));
            btnClosePwaGuide.addEventListener('click', () => pwaGuideModal.classList.add('hidden'));

            btnExport.addEventListener('click', () => {
                if (!currentUser) return;

                const exportData = currentUser.isAdmin 
                    ? dataAlker 
                    : dataAlker.filter(d => d.teknisi && d.teknisi.toUpperCase() === currentUser.name.toUpperCase());

                if (exportData.length === 0) {
                    alert("Belum ada data untuk diekspor!");
                    return;
                }

                const now = new Date();
                const dateStr = now.toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });
                const titleHeader = currentUser.isAdmin ? "LAPORAN SELURUH DATABASE ALAT KERJA TEKNISI" : `LAPORAN CEK ALAT KERJA - ${currentUser.name}`;

                const wsData = [
                    [titleHeader],
                    ["Tanggal Unduh:", dateStr, "Unit/Role:", currentUser.unit, "", "", "", "", "", ""],
                    [],
                    ["NO", "ALAT KERJA", "MERK / TYPE", "POSISI ALKER", "TEKNISI", "UNIT", "STO", "STATUS", "KETERANGAN", "TIMESTAMP"]
                ];

                exportData.forEach((row, i) => {
                    wsData.push([
                        i + 1,
                        row.alatKerja || "-",
                        row.merkType || "-",
                        row.posisiAlker || "-",
                        row.teknisi || "-",
                        row.unit || "-",
                        row.sto || "-",
                        row.status || "-",
                        row.keterangan || "-",
                        row.updatedAt || "-"
                    ]);
                });

                const worksheet = XLSX.utils.aoa_to_sheet(wsData);

                worksheet['!cols'] = [
                    { wch: 6 },
                    { wch: 24 },
                    { wch: 25 },
                    { wch: 16 },
                    { wch: 24 },
                    { wch: 16 },
                    { wch: 12 },
                    { wch: 14 },
                    { wch: 30 },
                    { wch: 22 }
                ];

                worksheet['!merges'] = [
                    { s: { r: 0, c: 0 }, e: { r: 0, c: 9 } }
                ];

                const workbook = XLSX.utils.book_new();
                XLSX.utils.book_append_sheet(workbook, worksheet, "Data Alat Kerja");

                const formattedDate = now.toISOString().slice(0, 10);
                const fileNamePrefix = currentUser.isAdmin ? 'Full_Database_Alker' : `Laporan_Alker_${currentUser.name.replace(/\s+/g, '_')}`;
                const fileName = `${fileNamePrefix}_${formattedDate}.xlsx`;

                XLSX.writeFile(workbook, fileName);
            });

            initCloudSync();
            if (currentUser) {
                updateAuthUI();
                renderTable();
                updateStats();
            } else {
                updateAuthUI();
            }
        });

        // Render Table Data
        function renderTable() {
            if (!currentUser) return;

            const searchInput = document.getElementById('searchInput');
            const filterPosisi = document.getElementById('filterPosisi');
            const filterStatus = document.getElementById('filterStatus');
            const tableBody = document.getElementById('tableBody');
            const emptyState = document.getElementById('emptyState');

            const search = searchInput ? searchInput.value.toLowerCase() : '';
            const posFilter = filterPosisi ? filterPosisi.value : '';
            const statusFil = filterStatus ? filterStatus.value : '';

            const filtered = dataAlker.filter((item) => {
                const isMyData = currentUser.isAdmin || (item.teknisi && item.teknisi.toUpperCase() === currentUser.name.toUpperCase());

                const matchesSearch = 
                    (item.alatKerja && item.alatKerja.toLowerCase().includes(search)) ||
                    (item.sto && item.sto.toLowerCase().includes(search)) ||
                    (item.merkType && item.merkType.toLowerCase().includes(search)) ||
                    (item.teknisi && item.teknisi.toLowerCase().includes(search)) ||
                    (item.unit && item.unit.toLowerCase().includes(search)) ||
                    (item.keterangan && item.keterangan.toLowerCase().includes(search));

                const matchesPosisi = posFilter === '' || item.posisiAlker === posFilter;
                const matchesStatus = statusFil === '' || item.status === statusFil;

                return isMyData && matchesSearch && matchesPosisi && matchesStatus;
            });

            filtered.sort((a, b) => (b.createdAtTime || 0) - (a.createdAtTime || 0));

            if (tableBody) tableBody.innerHTML = '';

            if (filtered.length === 0) {
                if (emptyState) emptyState.classList.remove('hidden');
            } else {
                if (emptyState) emptyState.classList.add('hidden');

                filtered.forEach((item) => {
                    let statusBadge = '';
                    if (item.status === 'Layak') {
                        statusBadge = `<span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200">Layak</span>`;
                    } else if (item.status === 'Rusak') {
                        statusBadge = `<span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-amber-100 text-amber-800 border border-amber-200">Rusak</span>`;
                    } else {
                        statusBadge = `<span class="px-2.5 py-1 text-xs font-semibold rounded-full bg-rose-100 text-rose-800 border border-rose-200">Tidak Ada</span>`;
                    }

                    const rowHtml = `
                        <tr class="hover:bg-slate-50 transition">
                            <td class="px-4 py-3">
                                ${item.foto 
                                    ? `<img src="${item.foto}" onclick="openImageModal('${item.foto}')" class="w-10 h-10 rounded-lg object-cover cursor-pointer hover:opacity-80 transition border border-slate-200 shadow-sm" alt="Foto Alker">`
                                    : `<div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center text-slate-400 border border-slate-200"><i data-lucide="image-off" class="w-5 h-5"></i></div>`}
                            </td>
                            <td class="px-4 py-3 font-semibold text-slate-800">${item.alatKerja || '-'}</td>
                            <td class="px-4 py-3 text-slate-600">${item.merkType || '-'}</td>
                            <td class="px-4 py-3"><span class="px-2 py-0.5 rounded bg-slate-100 border border-slate-200 font-medium text-xs text-slate-700">${item.posisiAlker || '-'}</span></td>
                            <td class="px-4 py-3 font-semibold text-indigo-700 uppercase">${item.teknisi || '-'}</td>
                            <td class="px-4 py-3"><span class="px-2 py-0.5 rounded bg-indigo-50 text-indigo-700 text-xs font-bold uppercase">${item.unit || '-'}</span></td>
                            <td class="px-4 py-3 font-mono text-xs font-bold text-slate-700 uppercase">${item.sto || '-'}</td>
                            <td class="px-4 py-3">${statusBadge}</td>
                            <td class="px-4 py-3 text-xs text-slate-600 max-w-xs truncate" title="${item.keterangan || ''}">${item.keterangan || '-'}</td>
                            <td class="px-4 py-3 text-xs text-slate-500 font-mono">${item.updatedAt || '-'}</td>
                            <td class="px-4 py-3 text-center space-x-1 whitespace-nowrap">
                                <button onclick="editData('${item.id}')" class="p-1.5 text-indigo-600 hover:text-indigo-900 hover:bg-indigo-50 rounded-lg transition" title="Edit Data">
                                    <i data-lucide="edit-3" class="w-4 h-4"></i>
                                </button>
                                <button onclick="deleteData('${item.id}')" class="p-1.5 text-rose-600 hover:text-rose-900 hover:bg-rose-50 rounded-lg transition" title="Hapus Data">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </td>
                        </tr>
                    `;
                    if (tableBody) tableBody.insertAdjacentHTML('beforeend', rowHtml);
                });
            }
            lucide.createIcons();
        }
    </script>
</body>
</html>