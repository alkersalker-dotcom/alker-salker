        // Firebase Setup & Real-time Cloud Listener using mandatory paths
        async function initCloudSync() {
            try {
                if (typeof window.auth !== 'undefined' && typeof window.cloudFunctions !== 'undefined') {
                    const { signInAnonymously, signInWithCustomToken } = window.cloudFunctions;
                    if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                        try {
                            await signInWithCustomToken(window.auth, __initial_auth_token);
                        } catch (e) {
                            await signInAnonymously(window.auth);
                        }
                    } else {
                        await signInAnonymously(window.auth);
                    }
                    setupFirestoreListener();
                } else {
                    dataAlker = JSON.parse(localStorage.getItem('cek_alker_db')) || [];
                    updateStats();
                    renderTable();
                }
            } catch (err) {
                console.warn("Firebase Auth fallback:", err);
                dataAlker = JSON.parse(localStorage.getItem('cek_alker_db')) || [];
                updateStats();
                renderTable();
            }
        }

        function setupFirestoreListener() {
            const { collection, onSnapshot } = window.cloudFunctions;
            const colRef = collection(window.db, 'artifacts', window.appId, 'public', 'data', 'public_data');
            
            if (unsubscribeFirestore) unsubscribeFirestore();

            unsubscribeFirestore = onSnapshot(colRef, (snapshot) => {
                const cloudItems = [];
                snapshot.forEach((docSnap) => {
                    cloudItems.push({ id: docSnap.id, ...docSnap.data() });
                });

                dataAlker = cloudItems;
                localStorage.setItem('cek_alker_db', JSON.stringify(dataAlker));
                
                const syncDot = document.getElementById('syncDot');
                const syncText = document.getElementById('syncText');
                if (syncDot) syncDot.className = "w-2 h-2 rounded-full bg-emerald-400 animate-pulse";
                if (syncText) syncText.textContent = "Cloud Synchronized";

                updateStats();
                renderTable();
            }, (error) => {
                console.error("Firestore sync error:", error);
                const syncDot = document.getElementById('syncDot');
                const syncText = document.getElementById('syncText');
                if (syncDot) syncDot.className = "w-2 h-2 rounded-full bg-amber-400";
                if (syncText) syncText.textContent = "Offline Mode";
                dataAlker = JSON.parse(localStorage.getItem('cek_alker_db')) || [];
                updateStats();
                renderTable();
            });
        }

