<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cek Alat Kerja - Manajemen Alat & Inventaris</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- SheetJS (xlsx) for full Excel export -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <!-- Custom Font -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, doc, setDoc, deleteDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Firebase Setup & Initialization complying with mandatory path and auth rules
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'cek-alker-app';
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
            apiKey: "demo-key",
            authDomain: "demo.firebaseapp.com",
            projectId: "demo-project",
            storageBucket: "demo.appspot.com",
            messagingSenderId: "123456789",
            appId: "1:123456789:web:demo"
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        window.db = db;
        window.auth = auth;
        window.appId = appId;
        window.cloudFunctions = { collection, doc, setDoc, deleteDoc, onSnapshot, signInAnonymously, signInWithCustomToken };
    </script>

    <link rel="manifest" id="manifestPlaceholder">
    <meta name="theme-color" content="#4338ca">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="Cek Alker">
    <link rel="apple-touch-icon" href="https://cdn-icons-png.flaticon.com/512/2942/2942544.png">

    <style>
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
    </style>
</head>
<body class="bg-slate-100 min-h-screen text-slate-800 flex flex-col">

    <!-- Top Navigation Bar -->
    <header class="bg-indigo-700 text-white shadow-lg sticky top-0 z-30">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5">
            <div class="flex items-center justify-between gap-2 sm:gap-4 flex-wrap md:flex-nowrap">
                
                <!-- Logo & Title -->
                <div class="flex items-center space-x-3 shrink-0">
                    <div class="p-2 bg-indigo-600/90 rounded-xl shadow-inner border border-indigo-400/30">
                        <i data-lucide="wrench" class="w-5 h-5 sm:w-6 sm:h-6 text-white"></i>
                    </div>
                    <div>
                        <h1 class="text-base sm:text-lg font-bold tracking-tight leading-tight">Cek Alat Kerja</h1>
                        <p class="text-[11px] text-indigo-200 hidden sm:block">Sistem Monitoring Alat Kerja</p>
                    </div>
                </div>

                <!-- Tab Menu Bar & Sync Status -->
                <div class="flex items-center gap-2">
                    <div id="navTabContainer" class="hidden md:flex items-center bg-indigo-800/80 p-1 rounded-xl border border-indigo-500/30">
                        <button id="tabDashboard" class="px-3 py-1.5 rounded-lg text-xs font-semibold transition flex items-center space-x-1.5 bg-white text-indigo-700 shadow-sm">
                            <i data-lucide="layout-dashboard" class="w-3.5 h-3.5"></i>
                            <span>Kelola Alker</span>
                        </button>
                    </div>

                    <!-- Cloud Sync Status Indicator -->
                    <div id="syncIndicator" class="flex items-center space-x-1.5 bg-indigo-900/60 px-2.5 py-1 rounded-full text-[11px] text-emerald-300 border border-emerald-500/30">
                        <span id="syncDot" class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        <span id="syncText">Cloud Connected</span>
                    </div>
                </div>

                <!-- User Info & Action Controls -->
                <div class="flex items-center space-x-2 shrink-0 ml-auto md:ml-0">
                    <!-- Install PWA Button -->
                    <button id="btnInstallPWA" class="bg-sky-500 hover:bg-sky-600 active:bg-sky-700 text-white font-semibold px-2.5 py-1.5 rounded-lg shadow-sm transition flex items-center space-x-1.5 text-xs border border-sky-400/40">
                        <i data-lucide="download" class="w-3.5 h-3.5"></i>
                        <span class="hidden sm:inline">Download App</span>
                        <span class="bg-white/20 text-white text-[9px] px-1.5 py-0.5 rounded font-bold uppercase tracking-wider">PWA</span>
                    </button>

                    <!-- User Info Card -->
                    <div id="userInfoContainer" class="hidden flex items-center space-x-2 bg-indigo-800/80 px-2.5 py-1 rounded-lg border border-indigo-500/40 text-xs">
                        <div id="userAvatar" class="w-6 h-6 rounded-full bg-indigo-500 flex items-center justify-center font-bold text-white text-[11px] shrink-0">
                            T
                        </div>
                        <div class="text-left hidden lg:block">
                            <div class="flex items-center space-x-1">
                                <p id="userNameDisplay" class="font-bold text-white leading-none text-xs max-w-[120px] truncate">Nama Teknisi</p>
                                <span id="adminBadge" class="hidden bg-amber-400 text-slate-900 font-black text-[8px] px-1 py-0.2 rounded uppercase">ADMIN</span>
                            </div>
                            <p id="userUnitDisplay" class="text-[9px] text-indigo-200">UNIT</p>
                        </div>
                        <button id="btnLogout" class="ml-1 p-1 text-rose-200 hover:text-white hover:bg-rose-500/30 rounded transition flex items-center" title="Keluar / Logout">
                            <i data-lucide="log-out" class="w-3.5 h-3.5"></i>
                        </button>
                    </div>

                    <!-- Add Data Button -->
                    <button id="btnOpenModal" class="hidden bg-emerald-500 hover:bg-emerald-600 active:bg-emerald-700 text-white font-medium px-3 py-1.5 rounded-lg shadow-md transition flex items-center space-x-1.5 text-xs border border-emerald-400/30">
                        <i data-lucide="plus-circle" class="w-4 h-4"></i>
                        <span class="hidden sm:inline">Tambah Data</span>
                    </button>
                </div>

            </div>
        </div>
    </header>

    <!-- MAIN CONTENT VIEW: VIEW 1 - HALAMAN MUKA (AUTHENTICATION LANDING PAGE) -->
    <div id="viewHome" class="flex-grow flex items-center justify-center p-4 sm:p-6 lg:p-8">
        <div class="max-w-md w-full bg-white rounded-3xl shadow-2xl border border-slate-200 overflow-hidden transform transition-all">
            <!-- Header Banner Card -->
            <div class="bg-gradient-to-r from-indigo-700 via-indigo-800 to-indigo-900 p-6 sm:p-8 text-white text-center relative overflow-hidden">
                <div class="absolute -right-6 -bottom-6 opacity-10 pointer-events-none">
                    <i data-lucide="shield-check" class="w-40 h-40 text-white"></i>
                </div>
                <div class="relative z-10 space-y-2">
                    <div class="inline-flex items-center justify-center p-3 bg-white/10 rounded-2xl backdrop-blur-md mb-2 border border-white/20 shadow-inner">
                        <i data-lucide="wrench" class="w-8 h-8 text-emerald-400"></i>
                    </div>
                    <h2 class="text-2xl font-extrabold tracking-tight">Cek Alat Kerja</h2>
                    <p class="text-xs text-indigo-200 leading-relaxed max-w-xs mx-auto">
                        Silakan login memilih Unit dan Nama Teknisi Anda untuk membuka aplikasi. Data tersinkronisasi otomatis via Cloud.
                    </p>
                </div>
            </div>

            <!-- Login Form -->
            <form id="mainLoginForm" class="p-6 sm:p-8 space-y-5">
                <!-- Alert Message Box for Invalid Unit/Teknisi combination -->
                <div id="loginErrorAlert" class="hidden p-3 bg-rose-50 border border-rose-200 text-rose-700 rounded-xl text-xs font-semibold flex items-center space-x-2">
                    <i data-lucide="alert-circle" class="w-5 h-5 text-rose-500 flex-shrink-0"></i>
                    <span id="loginErrorMessage">Maaf cek kembali Unit Anda</span>
                </div>

                <!-- 1. Select Unit -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5 flex items-center justify-between">
                        <span>Pilih Unit</span>
                        <span class="text-rose-500 font-normal text-[10px]">* Wajib</span>
                    </label>
                    <div class="relative">
                        <select id="loginUnit" required class="w-full border border-slate-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none bg-slate-50 hover:bg-white transition appearance-none">
                            <option value="">-- Pilih Unit --</option>
                            <option value="ADMIN">ADMIN</option>
                            <option value="ASSURANCE">ASSURANCE</option>
                            <option value="PROVISIONING">PROVISIONING</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400">
                            <i data-lucide="chevron-down" class="w-4 h-4"></i>
                        </div>
                    </div>
                </div>

                <!-- 2. Select Nama Teknisi / User -->
                <div>
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5 flex items-center justify-between">
                        <span>Pilih Nama Teknisi / User</span>
                        <span class="text-rose-500 font-normal text-[10px]">* Wajib</span>
                    </label>
                    <div class="relative">
                        <select id="loginTeknisi" required disabled class="w-full border border-slate-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none bg-slate-100 disabled:opacity-60 disabled:cursor-not-allowed transition appearance-none">
                            <option value="">-- Pilih Unit Terlebih Dahulu --</option>
                        </select>
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400">
                            <i data-lucide="user" class="w-4 h-4"></i>
                        </div>
                    </div>
                </div>

                <!-- 3. Password Input (Khusus Admin) -->
                <div id="adminPasswordContainer" class="hidden">
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1.5 flex items-center justify-between">
                        <span>Password Admin</span>
                        <span class="text-rose-500 font-normal text-[10px]">* Wajib</span>
                    </label>
                    <div class="relative">
                        <input type="password" id="loginPassword" placeholder="Masukkan Password Admin" class="w-full border border-slate-300 rounded-xl p-3 text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none bg-slate-50 hover:bg-white transition">
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none text-slate-400">
                            <i data-lucide="lock" class="w-4 h-4"></i>
                        </div>
                    </div>
                </div>

                <!-- Submit Button -->
                <div class="pt-2">
                    <button type="submit" class="w-full py-3.5 bg-emerald-500 hover:bg-emerald-600 active:bg-emerald-700 text-white rounded-xl font-bold text-sm shadow-lg shadow-emerald-500/20 transition flex items-center justify-center space-x-2 group">
                        <span>Masuk Aplikasi</span>
                        <i data-lucide="arrow-right" class="w-4 h-4 group-hover:translate-x-1 transition-transform"></i>
                    </button>
                </div>

                <div class="text-center pt-2">
                    <p class="text-[11px] text-slate-400 flex items-center justify-center space-x-1">
                        <i data-lucide="cloud-lightning" class="w-3 h-3 text-emerald-500"></i>
                        <span>Cloud Database Active & Real-time Sync</span>
                    </p>
                </div>
            </form>
        </div>
    </div>

    <!-- MAIN CONTENT VIEW: VIEW 2 - KELOLA ALKER DASHBOARD (LOCKED UNTIL LOGIN) -->
    <div id="viewDashboard" class="hidden flex-grow max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 space-y-6">

        <!-- Quick Summary Stats (Compact Version) -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
            <div class="bg-white p-3 rounded-xl border border-slate-200/80 shadow-sm hover:shadow-md transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p id="statTotalLabel" class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Total Item Alker</p>
                        <h3 id="homeStatTotal" class="text-xl font-extrabold text-slate-800 mt-0.5">0</h3>
                    </div>
                    <div class="p-2 bg-indigo-50 text-indigo-600 rounded-xl">
                        <i data-lucide="boxes" class="w-5 h-5"></i>
                    </div>
                </div>
                <p id="statScopeNote" class="text-[10px] text-slate-500 mt-1.5 flex items-center space-x-1">
                    <i data-lucide="info" class="w-3 h-3 text-indigo-500"></i>
                    <span>Tercatat di sistem</span>
                </p>
            </div>

            <div class="bg-white p-3 rounded-xl border border-slate-200/80 shadow-sm hover:shadow-md transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Status Layak</p>
                        <h3 id="homeStatLayak" class="text-xl font-extrabold text-emerald-600 mt-0.5">0</h3>
                    </div>
                    <div class="p-2 bg-emerald-50 text-emerald-600 rounded-xl">
                        <i data-lucide="check-circle-2" class="w-5 h-5"></i>
                    </div>
                </div>
                <p class="text-[10px] text-slate-500 mt-1.5 flex items-center space-x-1">
                    <i data-lucide="check" class="w-3 h-3 text-emerald-500"></i>
                    <span>Siap digunakan</span>
                </p>
            </div>

            <div class="bg-white p-3 rounded-xl border border-slate-200/80 shadow-sm hover:shadow-md transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Status Rusak</p>
                        <h3 id="homeStatRusak" class="text-xl font-extrabold text-amber-600 mt-0.5">0</h3>
                    </div>
                    <div class="p-2 bg-amber-50 text-amber-600 rounded-xl">
                        <i data-lucide="alert-triangle" class="w-5 h-5"></i>
                    </div>
                </div>
                <p class="text-[10px] text-slate-500 mt-1.5 flex items-center space-x-1">
                    <i data-lucide="wrench" class="w-3 h-3 text-amber-500"></i>
                    <span>Butuh perbaikan</span>
                </p>
            </div>

            <div class="bg-white p-3 rounded-xl border border-slate-200/80 shadow-sm hover:shadow-md transition">
                <div class="flex items-center justify-between">
                    <div>
                        <p class="text-[10px] font-semibold text-slate-500 uppercase tracking-wider">Tidak Ada / Hilang</p>
                        <h3 id="homeStatTidakAda" class="text-xl font-extrabold text-rose-600 mt-0.5">0</h3>
                    </div>
                    <div class="p-2 bg-rose-50 text-rose-600 rounded-xl">
                        <i data-lucide="x-circle" class="w-5 h-5"></i>
                    </div>
                </div>
                <p class="text-[10px] text-slate-500 mt-1.5 flex items-center space-x-1">
                    <i data-lucide="alert-circle" class="w-3 h-3 text-rose-500"></i>
                    <span>Konfirmasi teknisi</span>
                </p>
            </div>
        </div>

        <!-- Filter & Search Controls -->
        <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm space-y-3 md:space-y-0 md:flex md:items-center md:justify-between md:space-x-4">
            <!-- Search -->
            <div class="relative flex-1">
                <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                    <i data-lucide="search" class="w-4 h-4 text-slate-400"></i>
                </div>
                <input type="text" id="searchInput" placeholder="Cari berdasarkan Alat, Teknisi, atau STO..." class="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 outline-none transition">
            </div>
            
            <!-- Filters & Export -->
            <div class="flex flex-wrap items-center gap-2">
                <select id="filterPosisi" class="border border-slate-300 rounded-lg text-sm px-3 py-2 bg-white text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none">
                    <option value="">Semua Posisi</option>
                    <option value="Teknisi">Teknisi</option>
                    <option value="WH">WH (Warehouse)</option>
                    <option value="Service">Service</option>
                </select>

                <select id="filterStatus" class="border border-slate-300 rounded-lg text-sm px-3 py-2 bg-white text-slate-700 focus:ring-2 focus:ring-indigo-500 outline-none">
                    <option value="">Semua Status</option>
                    <option value="Layak">Layak</option>
                    <option value="Rusak">Rusak</option>
                    <option value="Tidak Ada">Tidak Ada</option>
                </select>

                <button id="btnExport" class="bg-emerald-600 hover:bg-emerald-700 text-white font-medium px-3.5 py-2 rounded-lg text-sm transition shadow-sm flex items-center space-x-2">
                    <i data-lucide="file-spreadsheet" class="w-4 h-4"></i>
                    <span>Ekspor Excel</span>
                </button>
            </div>
        </div>

        <!-- Data Table Section -->
        <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left text-sm">
                    <thead class="bg-slate-100 text-slate-700 border-b border-slate-200 font-semibold uppercase text-xs tracking-wider">
                        <tr>
                            <th class="px-4 py-3">Foto</th>
                            <th class="px-4 py-3">Alat Kerja</th>
                            <th class="px-4 py-3">Merk / Type</th>
                            <th class="px-4 py-3">Posisi Alker</th>
                            <th class="px-4 py-3">Teknisi</th>
                            <th class="px-4 py-3">Unit</th>
                            <th class="px-4 py-3">STO</th>
                            <th class="px-4 py-3">Status</th>
                            <th class="px-4 py-3">Keterangan</th>
                            <th class="px-4 py-3">TimeStamp</th>
                            <th class="px-4 py-3 text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody id="tableBody" class="divide-y divide-slate-200">
                        <!-- Dynamic Rows injected via JS -->
                    </tbody>
                </table>
            </div>

            <!-- Empty State -->
            <div id="emptyState" class="hidden py-12 text-center">
                <i data-lucide="folder-open" class="w-12 h-12 text-slate-300 mx-auto mb-3"></i>
                <p class="text-base font-medium text-slate-600">Belum ada data alat kerja untuk Anda</p>
                <p class="text-xs text-slate-400 mt-1">Klik tombol "Tambah Data" di atas untuk menambahkan data baru.</p>
            </div>
        </div>

    </div>

    <!-- MODAL POPUP FORM ALKER -->
    <div id="modalForm" class="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm hidden flex items-center justify-center p-4 overflow-y-auto">
        <div class="bg-white rounded-2xl shadow-2xl max-w-2xl w-full my-8 overflow-hidden transform transition-all flex flex-col max-h-[90vh]">
            
            <!-- Modal Header -->
            <div class="px-6 py-4 bg-indigo-700 text-white flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i data-lucide="clipboard-check" class="w-5 h-5"></i>
                    <h3 id="modalTitle" class="font-bold text-lg">Form Input Cek Alat Kerja</h3>
                </div>
                <button id="btnCloseModal" class="text-indigo-200 hover:text-white p-1 rounded-lg hover:bg-indigo-600 transition">
                    <i data-lucide="x" class="w-6 h-6"></i>
                </button>
            </div>

            <!-- Modal Body (Form Fields) -->
            <form id="alkerForm" class="p-6 space-y-4 overflow-y-auto flex-1">
                <input type="hidden" id="editId" value="">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    
                    <!-- 1. ALAT KERJA -->
                    <div class="md:col-span-2">
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">
                            1. ALAT KERJA <span class="text-rose-500">*</span>
                        </label>
                        <select id="fieldAlatKerja" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 outline-none bg-white">
                            <option value="">-- Pilih Alat Kerja --</option>
                            <option value="SPLICER">SPLICER</option>
                            <option value="DROPCORE STRIPPER">DROPCORE STRIPPER</option>
                            <option value="TOOLKIT FO (Streper)">TOOLKIT FO (Streper)</option>
                            <option value="CLEAVER">CLEAVER</option>
                            <option value="TEST PHONE">TEST PHONE</option>
                            <option value="LAN TESTER">LAN TESTER</option>
                            <option value="OPM">OPM</option>
                            <option value="SENTER">SENTER</option>
                            <option value="TANGGA 5,1">TANGGA 5,1</option>
                            <option value="TANGGA 4,4">TANGGA 4,4</option>
                            <option value="TOOKIT SET LENGKAP">TOOKIT SET LENGKAP</option>
                            <option value="BODY HARNES">BODY HARNES</option>
                            <option value="SARUNG TANGAN">SARUNG TANGAN</option>
                            <option value="HELM">HELM</option>
                            <option value="CRIMPING TOOL">CRIMPING TOOL</option>
                            <option value="TONE CHECKER">TONE CHECKER</option>
                            <option value="POWER BANK">POWER BANK</option>
                            <option value="KABEL VALIN">KABEL VALIN</option>
                            <option value="ONE CLICK">ONE CLICK</option>
                            <option value="TAS PUNGGUNG">TAS PUNGGUNG</option>
                            <option value="JAS HUJAN">JAS HUJAN</option>
                            <option value="OTDR MINI">OTDR MINI</option>
                        </select>
                    </div>

                    <!-- 2. MERK / TYPE -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">
                            2. MERK / TYPE <span class="text-rose-500">*</span>
                        </label>
                        <input type="text" id="fieldMerkType" placeholder="Contoh: Fujikura 70S / Signal Fire" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 outline-none">
                    </div>

                    <!-- 3. POSISI ALKER -->
                    <div>
                        <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">
                            3. POSISI ALKER <span class="text-rose-500">*</span>
                        </label>
                        <select id="fieldPosisiAlker" required class="w-full border border-slate-300 rounded-lg p-2.5 text-sm focus:ring-2 focus:ring-indigo-500 outline-none bg-white">
                            <option value="">-- Pilih Posisi Alker --</option>
